{
  "name": "pi-forge-workflow",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Forge workflow runtime and Skills for Pi",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extensions/forge-workflow/index.ts"],
    "skills": ["./skills"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "demo": "tsx examples/demo.ts",
    "demo:prd": "tsx examples/prd-demo.ts",
    "runtime": "tsx bin/task-runtime.ts",
    "prd-runtime": "tsx bin/prd-runtime.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.12.4",
    "tsx": "4.23.12",
    "typebox": "1.3.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
